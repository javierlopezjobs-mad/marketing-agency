# LLM configuration
# Model string with provider prefix (default: openai/gpt-4o-mini)
#LLM_MODEL=openai/gpt-4o-mini

# API key for the selected provider.
# Falls back to OPENAI_API_KEY when unset. Not required for ollama/* models
# or when LLM_BASE_URL points at a keyless OpenAI-compatible endpoint.
#LLM_API_KEY=your-provider-key

# Legacy variable, still honored as fallback:
OPENAI_API_KEY=sk-your-key-here

# Optional: custom OpenAI-compatible endpoint (e.g. a local server)
#LLM_BASE_URL=http://localhost:8080/v1

# Optional: sampling temperature (default: 0.7)
#LLM_TEMPERATURE=0.7

# --- Free-provider examples ---
# OpenRouter free tier (native support):
#   LLM_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct:free
# Ollama, fully local, no key needed:
#   LLM_MODEL=ollama/qwen2.5
# Groq free tier (requires optional extra: pip install litellm):
#   LLM_MODEL=groq/llama-3.3-70b-versatile
# Gemini free tier (requires extra: pip install "crewai[google-genai]"):
#   LLM_MODEL=gemini/gemini-2.0-flash
